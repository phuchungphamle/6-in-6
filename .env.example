# Set a unique random password with at least 12 characters before starting the server.
TEACHER_PASSWORD=replace-with-a-private-password-at-least-12-characters

# Required in production. Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

NODE_ENV=development
PORT=3000
DATA_DIR=./data
# Set to 1 only when the app is behind a trusted HTTPS reverse proxy.
TRUST_PROXY=0
